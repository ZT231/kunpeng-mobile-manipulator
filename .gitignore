# ============================================================
# Keil MDK 构建产物（体积大，每次编译都会重新生成）
# ============================================================
MDK-ARM/Robotic arm vision/
MDK-ARM/*.lst
MDK-ARM/build_log*.txt
MDK-ARM/JLinkLog.txt
MDK-ARM/*.uvguix.*
MDK-ARM/*.uvoptx
MDK-ARM/*.ZT

# Keil 通用中间文件
*.o
*.d
*.crf
*.dep
*.lnp
*.axf
*.iex
*.sct
*.map
*.htm

# ============================================================
# Python 缓存
# ============================================================
__pycache__/
*.py[cod]

# ============================================================
# 非核心 / 大体积资源
# ============================================================
# CMSIS DSP 官方示例（非本项目代码）
Drivers/CMSIS/DSP/Examples/
# 演示 PDF 辅助工具的大文件（若想保留这份 PDF，删掉下面这行即可）
docs/pdf_util/main.pdf
# 第三方手册的解包文本（141 个 page_*.txt，非本项目内容）
docs/pdf_util/extracted/
# 构建日志
build_output.txt

# ============================================================
# Keil 自动生成的备份副本
# ============================================================
*.0000

# ============================================================
# 标定产物（每台机器/每次标定都不同，不进版本库）
# 代码里已经有 gen_placeholder_calib.py 能随时重建占位文件，
# 真机标定结果留在板上 ~/kunpeng_vision/ 即可。
# ============================================================
kunpeng/robot/handeye_X.json
kunpeng/robot/camera_intrinsics.json
kunpeng/robot/samples.json
kunpeng/robot/intrinsics_imgs/
kunpeng/robot/collect_imgs/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
Thumbs.db
Desktop.ini
